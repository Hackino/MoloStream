<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash-screen icon: the mango "m" mark on a transparent canvas (the splash
  window background supplies the warm near-black). Sized to sit inside the
  Android-12 splash icon's circular keyline (content within the inner ~2/3).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <group
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:pivotX="512"
        android:pivotY="512"
        android:translateY="-16">
        <path
            android:strokeWidth="84"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M324,690 L324,396 M324,470 C324,408 372,372 432,372 C492,372 512,420 512,478 L512,690 M512,470 C512,408 560,372 620,372 C680,372 700,420 700,478 L700,690">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="300" android:startY="360"
                    android:endX="724" android:endY="680">
                    <item android:offset="0" android:color="#FFFFD089" />
                    <item android:offset="0.5" android:color="#FFFFA12E" />
                    <item android:offset="1" android:color="#FFF77F2A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
